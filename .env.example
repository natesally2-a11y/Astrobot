# ====== Telegram ======
# Получите токен у @BotFather
BOT_TOKEN=your_bot_token_here
# Публичный HTTPS URL для вебхука и Mini App (например, https://yourdomain.com)
WEBHOOK_BASE_URL=https://yourdomain.com
# Секрет для проверки вебхука Telegram (любая случайная строка)
WEBHOOK_SECRET=change-me-webhook-secret
# Режим запуска бота: polling (для разработки) или webhook (для прода)
BOT_MODE=polling

# ====== OpenAI ======
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o

# ====== База данных ======
DATABASE_URL=postgresql+asyncpg://stellarium:stellarium@db:5432/stellarium

# ====== Redis ======
REDIS_URL=redis://redis:6379/0

# ====== Безопасность Mini App ======
SECRET_KEY=change-me-secret-key-for-webapp-validation

# ====== Прочее ======
# Юзернейм бота (без @), используется в реферальных ссылках
BOT_USERNAME=stellarium_ai_bot
# Контактный e-mail для политики конфиденциальности
PRIVACY_CONTACT_EMAIL=privacy@example.com
LOG_LEVEL=INFO
