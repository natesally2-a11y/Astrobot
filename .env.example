# ===========================
# Stellarium AI — Environment
# ===========================

# --- Telegram ---
BOT_TOKEN=8730150448:AAF2WIWbalTieFVb2lc1kdtGIAkrtflgLvs
BOT_USERNAME=StellariumAIBot
# Public URL where Telegram will deliver webhooks. Leave empty for long polling.
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me-to-a-random-string

# --- Web / Mini App ---
APP_HOST=0.0.0.0
APP_PORT=8000
# Public base URL used to compose Mini App URLs (must be https for Telegram).
WEBAPP_PUBLIC_URL=https://yourdomain.com

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Database ---
# Async SQLAlchemy URL. Defaults to local SQLite for development.
DATABASE_URL=sqlite+aiosqlite:///./stellarium.db
# In production use:
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/stellarium

# --- Redis (optional) ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Swiss Ephemeris ---
# Path to ephemeris data files. Leave empty to use bundled Moshier model.
SWE_EPHE_PATH=

# --- Misc ---
DEFAULT_LANGUAGE=ru
ADMIN_IDS=
