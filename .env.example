# --- Telegram ---
# Obtain via @BotFather. Do not commit the real token.
BOT_TOKEN=replace_with_token_from_botfather

# Public HTTPS URL of the service (needed for webhooks and Mini App).
# Leave empty to use long polling in development.
WEBHOOK_URL=

# Secret path component appended to the webhook URL.
WEBHOOK_SECRET=change-me-to-a-random-string

# Bot username (without @). Used for referral links and inline mode hints.
BOT_USERNAME=stellarium_ai_bot

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# --- Database ---
DATABASE_URL=postgresql+asyncpg://stellarium:stellarium@db:5432/stellarium

# --- Redis (caching, FSM storage) ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
SECRET_KEY=change-me-to-a-random-32+character-string

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
USE_WEBHOOK=false

# --- Astrology ---
# Folder with Swiss Ephemeris data files (downloaded separately, optional).
EPHEMERIS_PATH=./ephemeris

# --- Pricing (in Telegram Stars) ---
PRO_PRICE_STARS=50
ORACLE_PRICE_STARS=150
