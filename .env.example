# ============================================================
#  Stellarium AI — environment configuration
#  Copy this file to `.env` and fill in the real values.
# ============================================================

# --- Telegram ---
# Get the token from @BotFather (/newbot or /token)
BOT_TOKEN=123456789:AA-replace-with-your-bot-token
# Public username of the bot (without @). Used for referral / inline links.
BOT_USERNAME=stellarium_ai_bot

# Run mode: "polling" for local development, "webhook" for production
RUN_MODE=polling
# Only required when RUN_MODE=webhook. Must be a public HTTPS URL.
WEBHOOK_URL=https://yourdomain.com
# Path the bot listens on for updates (combined with WEBHOOK_URL)
WEBHOOK_PATH=/webhook
# Optional secret token verifying that updates really come from Telegram
WEBHOOK_SECRET=change-me-webhook-secret

# Public base URL where the Mini App is served (HTTPS in production)
WEBAPP_URL=https://yourdomain.com

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
# Set to "true" to use deterministic offline stub responses (no API calls).
# Handy for local development / CI when you have no OpenAI key.
OPENAI_MOCK=false

# --- Database ---
# Async SQLAlchemy URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://stellarium:stellarium@db:5432/stellarium

# --- Redis (FSM storage + cache). Leave empty to use in-memory storage. ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Used to validate Telegram WebApp initData and sign internal tokens.
SECRET_KEY=change-me-to-a-long-random-string

# --- Geocoding (Nominatim / OpenStreetMap) ---
# Required by the Nominatim usage policy — set a contact email or app name.
NOMINATIM_USER_AGENT=stellarium-ai/1.0 (contact@example.com)

# --- Misc ---
# Comma-separated Telegram IDs that get full Premium access for testing.
ADMIN_IDS=
# Free plan daily AI question limit
FREE_DAILY_QUESTIONS=5
LOG_LEVEL=INFO
